{
  "name": "ib-interview-prep",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first PWA for investment banking interview prep: flashcards with spaced repetition and a weekly rule-based Market Pulse.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-data": "tsx scripts/validate-data.ts",
    "coverage-report": "tsx scripts/coverage-report.ts",
    "verify-feeds": "tsx scripts/verify-feeds.ts",
    "fetch-news": "tsx scripts/fetch-market-news.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "fast-xml-parser": "^4.5.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2",
    "zod": "^3.23.8"
  }
}
